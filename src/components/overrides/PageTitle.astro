// Where you are (breadcrumbs), the page title, and a status line: whether the page is
// complete, which Musa CAD release it was checked against and when, and which platforms it
// is about. Command and system variable pages then show the facts Musa CAD reports about them;
// release pages their downloads; troubleshooting pages who the problem affects and why.
import type { WikiRouteData } from '../../route-data';
import ReferenceHeader from '../reference/ReferenceHeader.astro';
import ReleaseHeader from '../reference/ReleaseHeader.astro';

type Entry = { type: 'link'; isCurrent: boolean; label: string; href: string } | { type: 'group'; label: string; entries: Entry[] };

const route = Astro.locals.starlightRoute as typeof Astro.locals.starlightRoute & { wiki: WikiRouteData };
const { entry, sidebar, lang } = route;
const wiki = route.wiki;
const t = Astro.locals.t;
const base = import.meta.env.BASE_URL;
const data = entry.data as typeof entry.data & { platforms?: string[]; kind?: string; command?: string; sysvar?: string; release?: string; symptom?: { affects: string; cause: string } };

function trail(entries: Entry[], acc: Entry[] = []): Entry[] | null {
	for (const e of entries) {
		if (e.type === 'link' && e.isCurrent) return acc;
		if (e.type === 'group') {
			const r = trail(e.entries, [...acc, e]);
			if (r) return r;
		}
	}
	return null;
}
const crumbs: { label: string; href?: string }[] = [];
if (data.kind === 'command') crumbs.push({ label: 'Command reference', href: `${base}reference/` });
else if (data.kind === 'sysvar') {
	crumbs.push({ label: 'Command reference', href: `${base}reference/` });
	crumbs.push({ label: 'System variables', href: `${base}reference/system-variables/` });
} else if (entry.id.startsWith('blog/')) crumbs.push({ label: 'Blog', href: `${base}blog/` });
else if (data.kind === 'release') crumbs.push({ label: 'Releases', href: `${base}releases/` });
else {
	const groups = trail(sidebar as Entry[]) ?? [];
	// A section's overview page carries its section's name as its title; one crumb is enough.
	if (groups.length && groups[groups.length - 1]!.label === entry.data.title) groups.pop();
	for (const g of groups) crumbs.push({ label: g.label });
}
const isRootLanding = (data.kind === 'landing' && (entry.id === '' || entry.id === 'index')) || entry.id === '404';
const showStatus = !isRootLanding && wiki.tracked && wiki.kind !== 'blog';
const verified = wiki.lastVerified ? wiki.lastVerified.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'UTC' }) : null;
const platformName: Record<string, string> = { windows: 'Windows', linux: 'Linux', macos: 'macOS' };
const refName = data.kind === 'command' ? data.command : data.kind === 'sysvar' ? data.sysvar : undefined;
---

{
	!isRootLanding && (
		<nav aria-label="Breadcrumb" data-pagefind-ignore>
			<ol class="mc-crumbs">
				<li>
					<a href={base}>{t('mc.home')}</a>
				</li>
				{crumbs.map((c) => (
					<li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>
				))}
				<li>
					<span aria-current="page">{entry.data.title}</span>
				</li>
			</ol>
		</nav>
	)
}

<h1 id="_top">{entry.data.title}</h1>

{
	showStatus && (
		<div class="mc-status" data-pagefind-ignore>
			<span class="mc-chip" data-status={wiki.status}>
				{t(`mc.status.${wiki.status}` as 'mc.status.complete')}
			</span>
			{wiki.tier === 'generated' && <span class="mc-chip">made from Musa CAD's own data</span>}
			<span>
				{t('mc.appliesTo')} {wiki.appliesTo}
			</span>
			{verified && wiki.lastVerified && (
				<span>
					{t('mc.verified')} <time datetime={wiki.lastVerified.toISOString()}>{verified}</time>
				</span>
			)}
			{data.platforms && <span>{data.platforms.map((p) => platformName[p] ?? p).join(' · ')}</span>}
		</div>
	)
}

{refName && <ReferenceHeader name={refName} />}
{data.kind === 'release' && data.release && <ReleaseHeader version={data.release} />}
{
	data.kind === 'troubleshooting' && data.symptom && (
		<section class="mc-ref not-content" aria-label="About this problem">
			<dl class="mc-ref-facts">
				<div>
					<dt>Who this affects</dt>
					<dd>{data.symptom.affects}</dd>
				</div>
				<div>
					<dt>Why it happens</dt>
					<dd>{data.symptom.cause}</dd>
				</div>
			</dl>
		</section>
	)
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
</style>
