---
// The page's notices, in this order: an announcement banner from frontmatter (Starlight's),
// then the version banner when the page is behind the pinned engine release, then the
// coverage notice for a stub or partial page. Stated, not hidden (§5 of the brief).
import type { WikiRouteData } from '../../route-data';

const route = Astro.locals.starlightRoute as typeof Astro.locals.starlightRoute & { wiki: WikiRouteData };
const { banner } = route.entry.data;
const wiki = route.wiki;
const t = Astro.locals.t;
const isKnown = wiki.behind !== null;
const isNotFound = route.entry.id === '404';
---

{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}

{
	!isNotFound && wiki.level !== 'ok' && (
		<p class="mc-notice" data-level={wiki.level} data-pagefind-ignore>
			<span>
				{isKnown ? (
					<>
						<strong>Musa CAD {wiki.appliesTo}.</strong>{' '}
						{t('mc.stale.behind', { appliesTo: wiki.appliesTo, current: wiki.current, count: String(wiki.behind) })}
					</>
				) : (
					<>
						<strong>Unknown version.</strong> This page says it was checked against Musa CAD {wiki.appliesTo || '(none)'},
						which is not a release the wiki knows. The current release is {wiki.current}.
					</>
				)}
			</span>
		</p>
	)
}
{
	!isNotFound && wiki.status === 'stub' && (
		<p class="mc-notice" data-level="stub" data-pagefind-ignore>
			<span>
				<strong>{t('mc.status.stub')}.</strong> {t('mc.stub.notice')}
			</span>
		</p>
	)
}
{
	!isNotFound && wiki.status === 'partial' && (
		<p class="mc-notice" data-level="partial" data-pagefind-ignore>
			<span>
				<strong>{t('mc.status.partial')}.</strong> {t('mc.partial.notice')}
			</span>
		</p>
	)
}

<style>
	@layer starlight.core {
		.sl-banner {
			--__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
			color: var(--__sl-banner-text);
			line-height: var(--sl-line-height-headings);
			text-align: center;
			text-wrap: balance;
			box-shadow: var(--sl-shadow-sm);
		}
		.sl-banner :global(a) {
			color: var(--__sl-banner-text);
		}
	}
</style>
