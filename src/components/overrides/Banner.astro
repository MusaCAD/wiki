---
// SPDX-License-Identifier: LGPL-3.0-or-later
// Copyright (C) 2026 Pranay Kiran

// The notices at the top of a page, in this order: an announcement from the page's own
// frontmatter; a note when the page was checked against an older release than the newest;
// a note when the page is only partly written, or not written yet. A reader should know how
// far to trust a page before reading it.
import type { WikiRouteData } from '../../route-data';

const route = Astro.locals.starlightRoute as typeof Astro.locals.starlightRoute & { wiki: WikiRouteData };
const { banner } = route.entry.data;
const wiki = route.wiki;
const t = Astro.locals.t;
const show = wiki.tracked && route.entry.id !== '404';
const known = wiki.behind !== null;
---

{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}

{
	show && wiki.level !== 'ok' && (
		<p class="mc-notice" data-level={wiki.level} data-pagefind-ignore>
			<span>
				{known ? (
					<>
						<strong>Checked against Musa CAD {wiki.appliesTo}.</strong>{' '}
						{t('mc.stale.behind', { appliesTo: wiki.appliesTo, current: wiki.current })}
					</>
				) : (
					<>
						<strong>Unknown version.</strong> This page says it was checked against Musa CAD {wiki.appliesTo}, which is
						not a released version. The newest release is {wiki.current}.
					</>
				)}
			</span>
		</p>
	)
}
{
	show && wiki.status === 'stub' && (
		<p class="mc-notice" data-level="stub" data-pagefind-ignore>
			<span>
				<strong>{t('mc.status.stub')}.</strong> {t('mc.stub.notice')}
			</span>
		</p>
	)
}
{
	show && wiki.status === 'partial' && (
		<p class="mc-notice" data-level="partial" data-pagefind-ignore>
			<span>
				<strong>{t('mc.status.partial')}.</strong> {t('mc.partial.notice')}
			</span>
		</p>
	)
}

<style>
	@layer starlight.core {
		.sl-banner {
			--__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
			color: var(--__sl-banner-text);
			line-height: var(--sl-line-height-headings);
			text-align: center;
			text-wrap: balance;
			box-shadow: var(--sl-shadow-sm);
		}
		.sl-banner :global(a) {
			color: var(--__sl-banner-text);
		}
	}
</style>
