---
// SPDX-License-Identifier: LGPL-3.0-or-later
// Copyright (C) 2026 Pranay Kiran
// An illustration plotted by the engine itself from a drawing in examples/. The build renders
// it (scripts/render-examples.mjs) with the pinned release, so it cannot drift from the
// software; if the example stops plotting, the build fails. Alt text is required.
import manifest from '../data/rendered.json';

interface Props {
	/** The example id: examples/<id>.musa */
	id: string;
	/** What the picture shows, for readers who cannot see it. Required. */
	alt: string;
	caption?: string;
	/** Offer the drawing file for download (default: yes). */
	download?: boolean;
	/** Load at once: for the first figure on a page, which is what the page paints largest. */
	eager?: boolean;
}
const { id, alt, caption, download = true, eager = false } = Astro.props;
type Entry = { engine: string; args: string; width: number; height: number; file: string };
const entry = (manifest as Record<string, Entry>)[id];
if (!entry) throw new Error(`<Figure id="${id}">: no rendered example. Add examples/${id}.musa and run npm run render.`);
if (!alt || !alt.trim()) throw new Error(`<Figure id="${id}">: alt text is required.`);
const base = import.meta.env.BASE_URL;
const t = Astro.locals.t;
---

<figure class="mc-figure not-content">
	<div class="mc-figure-sheet">
		<img src={`${base}rendered/${id}.svg`} width={entry.width} height={entry.height} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
	<div class="mc-figure-meta">
		<span>{t('mc.figure.renderedBy', { version: entry.engine })} <code>{entry.file}</code></span>
		{download && (
			<a href={`${base}examples/${entry.file}`} download>
				{t('mc.figure.download')}
			</a>
		)}
	</div>
</figure>
