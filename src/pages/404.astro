// The 404 page. Starlight's injected route is disabled (astro.config.mjs) because a 404 entry
// in the docs collection and the injected route both claim /404; this page claims it alone
// and Astro writes it as 404.html, which GitHub Pages serves.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Page not found',
		description: 'There is no page at this address on the Musa CAD Wiki. Search, or start from the home page.',
		tableOfContents: false,
		pagefind: false,
		editUrl: false,
		tier: 'human',
		appliesTo: '0.8.0',
		lastVerified: new Date('2026-10-23'),
		status: 'complete',
		kind: 'landing',
	}}
>
	<p>There is no page at this address.</p>
	<ul>
		<li>Press <kbd>/</kbd> to search, the way you would start typing a command.</li>
		<li>Start from the <a href={import.meta.env.BASE_URL}>home page</a> or <a href={`${import.meta.env.BASE_URL}get-started/`}>Get started</a>.</li>
		<li>If a link on this wiki brought you here, <a href="https://github.com/MusaCAD/wiki/issues/new?template=page-problem.yml">report it</a>.</li>
	</ul>
	<p>
		The wiki is being written section by section, so a section you expect may not exist yet. The engine repository's
		<a href="https://github.com/MusaCAD/MusaCAD/tree/main/docs">documents</a> are the reference until it does.
	</p>
</StarlightPage>
